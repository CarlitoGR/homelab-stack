# {{ ansible_managed }}
services:
  uptime-kuma:
    image: louislam/uptime-kuma:{{ uptime_kuma_version }}
    container_name: uptime-kuma
    restart: unless-stopped
    environment:
      TZ: {{ nas_timezone }}
    volumes:
      - ./data:/app/data
    security_opt:
      - no-new-privileges:true
    mem_limit: 256m
    networks:
      - default # outbound: alerts (email, Telegram, push) and monitoring external sites
      - edge # inbound via Caddy; can also check internal apps, e.g. http://timesheet:8000/api/healthz

networks:
  edge:
    name: {{ nas_edge_network }}
    external: true
