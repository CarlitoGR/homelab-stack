# {{ ansible_managed }}
services:
  caddy:
    image: caddy:{{ edge_caddy_version }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "{{ edge_https_port }}:443"
    volumes:
      - ./caddy/etc:/etc/caddy:ro
      - ./caddy/data:/data
      - ./caddy/config:/config
    security_opt:
      - no-new-privileges:true
    mem_limit: 128m
    networks:
      - default
      - edge

  authelia:
    image: authelia/authelia:{{ edge_authelia_version }}
    container_name: authelia
    restart: unless-stopped
    environment:
      TZ: {{ nas_timezone }}
      AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE: /secrets/jwt_secret
      AUTHELIA_SESSION_SECRET_FILE: /secrets/session_secret
      AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE: /secrets/storage_encryption_key
{% if authelia_ldap_enabled | bool %}
      AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD_FILE: /secrets/ldap_password
{% endif %}
    volumes:
      - ./authelia/config:/config
      - ./authelia/secrets:/secrets:ro
    security_opt:
      - no-new-privileges:true
    mem_limit: 128m
    networks:
      - default # outbound only: NTP check, LDAP
      - edge

networks:
  edge:
    name: {{ nas_edge_network }}
    internal: true # no route to the LAN or internet; apps are reachable only through Caddy
