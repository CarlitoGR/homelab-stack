# {{ ansible_managed }}
services:
  timesheet:
    build: ./src
    image: timesheet-calc:local
    container_name: timesheet
    restart: unless-stopped
    # No `ports:` on purpose. The app trusts the Remote-User header, so it must be reachable ONLY through Caddy.
    environment:
      TIMESHEET_AUTH_MODE: header
      TIMESHEET_AUTH_USER_HEADER: Remote-User
      TIMESHEET_AUTH_ALLOWED_USERS: {{ timesheet_allowed_users | join(',') | to_json }}
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    mem_limit: 256m
    cpus: 0.5
    networks:
      - edge

networks:
  edge:
    name: {{ nas_edge_network }}
    external: true
